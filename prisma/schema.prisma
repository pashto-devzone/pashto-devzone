generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model App {
  id                 Int          @id @default(autoincrement())
  name               String
  slug               String       @unique
  description        String?
  shortDescription   String?
  category           String?
  developer          String?
  features           String?
  screenshots        String?
  systemRequirements String?
  logo               String?
  active             Boolean      @default(true)
  licenseRequired    Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  versions           AppVersion[]
  licenses           License[]
  orders             Order[]
  receipts           Receipt[]
  downloads          DownloadLog[]
  reviews            Review[]
}

model Review {
  id        Int      @id @default(autoincrement())
  appId     Int
  name      String
  rating    Int
  review    String
  createdAt DateTime @default(now())
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
}

model AppVersion {
  id           Int           @id @default(autoincrement())
  appId        Int
  version      String
  downloadUrl  String?
  releaseDate  DateTime?
  size         String?
  releaseNotes String?
  latest       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  app          App           @relation(fields: [appId], references: [id], onDelete: Cascade)
  licenses     License[]
  downloads    DownloadLog[]
}

model Customer {
  id          Int            @id @default(autoincrement())
  name        String
  phone       String?
  whatsapp    String?
  email       String?
  country     String?
  city        String?
  company     String?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  orders      Order[]
  receipts    Receipt[]
  licenses    License[]
  downloads   DownloadLog[]
}

model Order {
  id             Int          @id @default(autoincrement())
  orderNumber    String       @unique
  customerId     Int
  orderType      String       @default("PRE_BUILT") // PRE_BUILT | CUSTOM
  appId          Int?
  projectName    String?
  description    String?
  price          Float        @default(0)
  advance        Float        @default(0)
  remaining      Float        @default(0)
  status         String       @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | CANCELLED
  paymentStatus  String       @default("PENDING") // PENDING | PARTIAL | PAID
  createdAt      DateTime     @default(now())
  completionDate DateTime?
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  app            App?         @relation(fields: [appId], references: [id], onDelete: SetNull)
  receipts       Receipt[]
  licenses       License[]
}

model Receipt {
  id               Int             @id @default(autoincrement())
  receiptNumber    String          @unique
  customerId       Int
  orderId          Int?
  appId            Int?
  price            Float           @default(0)
  amountPaid       Float           @default(0)
  remaining        Float           @default(0)
  paymentType      String          @default("FULL")
  paymentMethod    String          @default("Cash")
  paymentAccountId Int?
  currency         String          @default("PKR")
  issueDate        DateTime        @default(now())
  notes            String?
  createdAt        DateTime        @default(now())
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  app              App?            @relation(fields: [appId], references: [id], onDelete: SetNull)
  paymentAccount   PaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
}

model PaymentAccount {
  id            Int       @id @default(autoincrement())
  accountName   String
  bankType      String    @default("BANK") // BANK | EASYPAISA | JAZZCASH | OTHER
  accountHolder String?
  iban          String?
  accountNumber String?
  phone         String?
  branch        String?
  active        Boolean   @default(true)
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  receipts      Receipt[]
}

model License {
  id             Int          @id @default(autoincrement())
  code           String       @unique
  customerId     Int
  appId          Int
  orderId        Int?
  versionId      Int?
  version        String?
  status         String       @default("UNUSED") // UNUSED | USED | EXPIRED
  paymentStatus  String       @default("PENDING") // PENDING | PARTIAL | PAID
  generatedBy    String?      @default("admin")
  createdAt      DateTime     @default(now())
  expiresAt      DateTime
  usedAt         DateTime?
  downloadCount  Int          @default(0)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  app            App          @relation(fields: [appId], references: [id], onDelete: Restrict)
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  versionModel   AppVersion?  @relation(fields: [versionId], references: [id], onDelete: SetNull)
  downloads      DownloadLog[]
}

model DownloadLog {
  id             Int          @id @default(autoincrement())
  customerId     Int?
  licenseId      Int?
  appId          Int?
  versionId      Int?
  version        String?
  browser        String?
  os             String?
  deviceType     String?
  ip             String?
  country        String?
  downloadedAt   DateTime     @default(now())
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  license        License?     @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  app            App?         @relation(fields: [appId], references: [id], onDelete: SetNull)
  versionModel   AppVersion?  @relation(fields: [versionId], references: [id], onDelete: SetNull)
}
