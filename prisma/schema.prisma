generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model App {
  id                 Int           @id @default(autoincrement())
  name               String
  slug               String        @unique
  description        String?
  shortDescription   String?
  category           String?
  developer          String?
  features           String?
  screenshots        String?
  systemRequirements String?
  logo               String?
  active             Boolean       @default(true)
  licenseRequired    Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  versions           AppVersion[]
  downloads          DownloadLog[]
  licenses           License[]
  orders             Order[]
  receipts           Receipt[]
  reviews            Review[]
}

model Review {
  id        Int      @id @default(autoincrement())
  appId     Int
  name      String
  rating    Int
  review    String
  createdAt DateTime @default(now())
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
}

model AppVersion {
  id           Int           @id @default(autoincrement())
  appId        Int
  version      String
  downloadUrl  String?
  releaseDate  DateTime?
  size         String?
  releaseNotes String?
  latest       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  app          App           @relation(fields: [appId], references: [id], onDelete: Cascade)
  downloads    DownloadLog[]
  licenses     License[]
}

model Customer {
  id        Int           @id @default(autoincrement())
  name      String
  phone     String?
  whatsapp  String?
  email     String?
  country   String?
  city      String?
  company   String?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  downloads DownloadLog[]
  licenses  License[]
  orders    Order[]
  receipts  Receipt[]
}

model Order {
  id             Int       @id @default(autoincrement())
  orderNumber    String    @unique
  customerId     Int
  orderType      String    @default("PRE_BUILT")
  appId          Int?
  projectName    String?
  description    String?
  price          Float     @default(0)
  advance        Float     @default(0)
  remaining      Float     @default(0)
  status         String    @default("PENDING")
  paymentStatus  String    @default("PENDING")
  createdAt      DateTime  @default(now())
  completionDate DateTime?
  licenses       License[]
  app            App?      @relation(fields: [appId], references: [id])
  customer       Customer  @relation(fields: [customerId], references: [id])
  receipts       Receipt[]
}

model Receipt {
  id               Int             @id @default(autoincrement())
  receiptNumber    String          @unique
  customerId       Int
  orderId          Int?
  appId            Int?
  projectName      String?
  price            Float           @default(0)
  amountPaid       Float           @default(0)
  remaining        Float           @default(0)
  paymentType      String          @default("FULL")
  paymentMethod    String          @default("Cash")
  paymentAccountId Int?
  currency         String          @default("PKR")
  issueDate        DateTime        @default(now())
  notes            String?
  createdAt        DateTime        @default(now())
  app              App?            @relation(fields: [appId], references: [id])
  customer         Customer        @relation(fields: [customerId], references: [id])
  order            Order?          @relation(fields: [orderId], references: [id])
  paymentAccount   PaymentAccount? @relation(fields: [paymentAccountId], references: [id])
}

model PaymentAccount {
  id            Int       @id @default(autoincrement())
  accountName   String
  bankType      String    @default("BANK")
  accountHolder String?
  iban          String?
  accountNumber String?
  phone         String?
  branch        String?
  active        Boolean   @default(true)
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  receipts      Receipt[]
}

model License {
  id            Int           @id @default(autoincrement())
  code          String        @unique
  customerId    Int
  appId         Int
  orderId       Int?
  versionId     Int?
  version       String?
  status        String        @default("UNUSED")
  paymentStatus String        @default("PENDING")
  generatedBy   String?       @default("admin")
  createdAt     DateTime      @default(now())
  expiresAt     DateTime
  usedAt        DateTime?
  downloadCount Int           @default(0)
  downloads     DownloadLog[]
  app           App           @relation(fields: [appId], references: [id])
  customer      Customer      @relation(fields: [customerId], references: [id])
  order         Order?        @relation(fields: [orderId], references: [id])
  versionModel  AppVersion?   @relation(fields: [versionId], references: [id])
}

model DownloadLog {
  id           Int         @id @default(autoincrement())
  customerId   Int?
  licenseId    Int?
  appId        Int?
  versionId    Int?
  version      String?
  browser      String?
  os           String?
  deviceType   String?
  ip           String?
  country      String?
  downloadedAt DateTime    @default(now())
  app          App?        @relation(fields: [appId], references: [id])
  customer     Customer?   @relation(fields: [customerId], references: [id])
  license      License?    @relation(fields: [licenseId], references: [id])
  versionModel AppVersion? @relation(fields: [versionId], references: [id])
}
